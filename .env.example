# AI21 Maestro + Bright Data API 配置
# 将此文件复制到 .env，并填入你的实际 API 密钥

# AI21 Labs API 密钥
# 从此处获取 API 密钥：https://studio.ai21.com/
AI21_LABS_KEY=your_ai21_labs_api_key_here

# Bright Data 令牌
# 从此处获取令牌：https://www.bright.cn/
BRIGHTDATA_TOKEN=your_brightdata_token_here

# 可选：服务器配置
# PORT=8000
# HOST=0.0.0.0

# 可选：CORS 配置（用于生产环境）
# ALLOWED_ORIGINS=["http://localhost:3000", "https://yourdomain.com"]